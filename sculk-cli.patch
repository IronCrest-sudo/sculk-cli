+	msg := err.Error()
+	for _, want := range []string{"9.9.9", "1.0.0", "2.0.0"} {
+		if !strings.Contains(msg, want) {
+			t.Errorf("error should mention %q, got: %s", want, msg)
+		}
+	}
+}
+
+func TestListRemoteRefsIgnoresNonVersionBranches(t *testing.T) {
