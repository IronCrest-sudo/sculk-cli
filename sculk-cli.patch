+	for in, want := range cases {
+		spec, err := ParseSpec(in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := spec.String(); got != want {
+			t.Errorf("ParseSpec(%q).String() = %q, want %q", in, got, want)
