+package add
+
+import "testing"
+
+func TestParseSpec(t *testing.T) {
+	cases := []struct {
+		in      string
+		id      string
+		ver     string
+		gameVer string
+		isURL   bool
+	}{
+		// plain identifier
+		{"id-system", "id-system", "", "", false},
+
+		// README examples
+		{"id-system@1.0.0", "id-system", "1.0.0", "", false},
+		{"id-system@1.0.0/26.2", "id-system", "1.0.0", "26.2", false},
