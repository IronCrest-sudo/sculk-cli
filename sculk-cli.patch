diff --git a/website/src/components/UI/CodeBlock.astro b/website/src/components/UI/CodeBlock.astro
new file mode 100644
index 0000000..fa689d3
--- /dev/null
+++ b/website/src/components/UI/CodeBlock.astro
@@ -0,0 +1,21 @@
+---
+// A small shell-style code block with a copy button. `code` may contain
+// several lines separated by "\n".
+const { code } = Astro.props as { code: string };
+
+const lines = code.split('\n').map((l) => l.trim()).filter((l) => l.length > 0);
+---
+
+<div class="rounded-lg border border-white/10 bg-black/40 p-3">
+    <div class="flex items-start gap-2">
+        <pre class="flex-1 overflow-x-auto font-ui text-[11px] leading-relaxed text-emerald-300">{lines.map((l) => '$ ' + l).join('\n')}</pre>
+        <button
+            type="button"
+            data-copy={lines.join('\n')}
+            class="shrink-0 rounded px-2 py-0.5 font-ui text-[10px] text-white/40 transition-colors hover:bg-white/10 hover:text-white"
+            aria-label="Copy command"
+        >
+            <span data-copy-label>copy</span>
+        </button>
+    </div>
+</div>
diff --git a/website/src/components/UI/LibraryCard.astro b/website/src/components/UI/LibraryCard.astro
new file mode 100644
index 0000000..39d29f1
--- /dev/null
+++ b/website/src/components/UI/LibraryCard.astro
@@ -0,0 +1,80 @@
+---
+import type { LibraryEntry } from '../../data/libraries';
+
+const { lib } = Astro.props as { lib: LibraryEntry };
+
+const search = [
+    lib.identifier,
+    lib.description ?? '',
+    lib.author ?? '',
+    lib.source,
+    lib.subdir ?? '',
+    lib.kind,
+].join(' ');
+
+const installCmd = `sculk add ${lib.identifier}`;
+const repoName = lib.source.replace(/\.git$/, '').split('/').slice(-2).join('/');
+
+// Tailwind's "/" is not legal in an Astro `class:` directive name, so the
+// badge palette is resolved here instead.
+const kindClass =
+    lib.kind === 'resourcepack'
+        ? 'bg-emerald-500/20 text-emerald-200'
+        : 'bg-purple-500/20 text-purple-200';
+---
+
+<article
+    data-lib-card
+    data-identifier={lib.identifier}
+    data-search={search}
+    class="group flex flex-col gap-3 rounded-xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-purple-400/60 hover:bg-white/[0.06]"
+>
+    <header class="flex items-start justify-between gap-3">
+        <h3 class="font-ui text-base text-white break-all">{lib.identifier}</h3>
+        <span class="shrink-0 rounded-md px-2 py-0.5 font-ui text-[10px] uppercase tracking-wider {kindClass}">
+            {lib.kind === 'resourcepack' ? 'rp' : 'dp'}
+        </span>
+    </header>
+
+    <p class="font-ui text-xs leading-relaxed text-white/70 flex-1">
+        {lib.description ?? 'No description provided.'}
+    </p>
+
+    {lib.notice && (
+        <p class="rounded-md border border-amber-400/30 bg-amber-400/10 px-3 py-2 font-ui text-[11px] leading-relaxed text-amber-200/90">
+            ⚠ {lib.notice}
+        </p>
+    )}
+
+    <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 font-ui text-[11px] text-white/50">
+        {lib.author && (
+            <>
+                <dt class="text-white/35">author</dt>
+                <dd class="text-white/70 break-all">{lib.author}</dd>
+            </>
+        )}
+        <dt class="text-white/35">repo</dt>
+        <dd class="break-all">
+            <a href={lib.homepage ?? lib.source} target="_blank" rel="noopener noreferrer"
+               class="text-purple-300 hover:text-purple-200">{repoName}</a>
+        </dd>
+        {lib.subdir && (
+            <>
+                <dt class="text-white/35">path</dt>
+                <dd class="text-white/70 break-all">{lib.subdir}</dd>
+            </>
+        )}
+    </dl>
+
+    <div class="mt-auto flex items-center gap-2 rounded-lg border border-white/10 bg-black/40 px-3 py-2">
+        <code class="flex-1 truncate font-ui text-[11px] text-emerald-300">{installCmd}</code>
+        <button
+            type="button"
+            data-copy={installCmd}
+            class="shrink-0 rounded px-2 py-0.5 font-ui text-[10px] text-white/50 transition-colors hover:bg-white/10 hover:text-white"
+            aria-label={`Copy install command for ${lib.identifier}`}
+        >
+            <span data-copy-label>copy</span>
+        </button>
+    </div>
+</article>
